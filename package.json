{
  "name": "porlocal",
  "version": "0.1.0",
  "description": "Local dev helper: leases ports, supervises dev servers, maps device ports, shows it all in a dashboard",
  "license": "MIT",
  "type": "module",
  "bin": {
    "porlocal": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm dashboard:build",
    "dev": "tsc -p tsconfig.json --watch",
    "dashboard:build": "cd dashboard && vite build",
    "dashboard:dev": "cd dashboard && vite dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p dashboard/tsconfig.json",
    "test": "vitest run",
    "wt": "node scripts/my-stack/wt/bin/wt.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/modals": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@lxtzfr/wt",
      "esbuild"
    ]
  },
  "myStack": {
    "services": {
      "dashboard": {
        "port": 4090,
        "run": "pnpm dashboard:dev"
      }
    },
    "env": {
      "DASHBOARD_PORT": "{port:dashboard}"
    }
  },
  "dependencies": {
    "@lxtzfr/wt": "github:lxtzfr/wt#v0.1.0"
  }
}
